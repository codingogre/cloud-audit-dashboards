# Elasticsearch endpoint of the Elastic Cloud Serverless project
EC_URL=https://<project>.es.<region>.<csp>.elastic.cloud/
# Kibana endpoint of the same project
KB_URL=https://<project>.kb.<region>.<csp>.elastic.cloud/
# API key with manage_index_templates, manage_ingest_pipelines, read on the audit
# data stream, and Kibana write access to the Default space (where the suite installs)
EC_API_KEY=<base64 api key>
# Optional: the audit data stream. Elastic renamed it; new projects write to
# logs-elastic_cloud.serverless_audit.otel-default
AUDIT_STREAM=logs-elastic_cloud.serverless_audit.otel-default
