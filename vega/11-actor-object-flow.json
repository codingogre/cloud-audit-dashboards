{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "How the current selection's Kibana activity flows: which credential it arrived with, which space it happened in, what kind of object it touched and what it did to it. Ribbon width is event count in the time picker's range. Kibana audit only, and only events that touched an object — requests, logins and point-in-time internals are left out. Elasticsearch events carry no space and no saved object, so including them would put most of the ink in a branch that says nothing. Credential is authentication type where Elasticsearch records one and the user's realm otherwise, which is what separates a person in a browser (SAML SSO, the cloud-saml-kibana realm) from a script calling Kibana with a key (Elasticsearch or Cloud API key); hover a credential for its raw name. Object types come from the shared OBJ_TYPE fragment, which recovers a type from the event for workflows, ML jobs, agent-builder tools and secrets that carry no saved-object fields. Every event is counted, so each column adds up to the same total and Operation's delete is every Kibana delete of an object — saved_object_delete, space_delete and the feature deletes, including the objects a deleted space took with it — which is at least the delete rows of the scoring table above. Each column names its seven biggest values and folds the rest into \"other (N)\", drawn last. A small value is drawn at a minimum height so that it can carry its label: heights are proportional above that floor, and the number beside each value is exact. Click a named credential or space to pin it across the suite — object type and operation are derived, so a pill on them would match nothing. Double-click anywhere in the panel to clear every pill on the page.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 4,
  "signals": [
    {
      "name": "nodeW",
      "value": 10
    },
    {
      "name": "gap",
      "value": 5
    },
    {
      "name": "head",
      "value": 20
    },
    {
      "name": "hoverKey",
      "value": null,
      "on": [
        {
          "events": "@node:mouseover",
          "update": "datum.key"
        },
        {
          "events": "@node:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "pin",
      "value": null,
      "on": [
        {
          "events": "@node:click",
          "update": "indexof(datum.label, 'other (') === 0 ? null : datum.stage === 0 && datum.label !== 'unknown' ? kibanaAddFilter({bool: {should: [{match_phrase: {'authentication.type': datum.label}}, {match_phrase: {'user.domain': datum.label}}], minimum_should_match: 1}}, 'logs-elastic_cloud.serverless_audit.otel-default', 'credential: ' + datum.label) : datum.stage === 1 && datum.label !== 'no space' ? kibanaAddFilter({match_phrase: {'kibana.space.id': datum.label}}, 'logs-elastic_cloud.serverless_audit.otel-default', 'space: ' + datum.label) : null"
        }
      ]
    },
    {
      "name": "clearAll",
      "value": null,
      "on": [
        {
          "events": "dblclick",
          "update": "kibanaRemoveAllFilters()"
        }
      ]
    },
    {
      "name": "foldK",
      "value": 8
    },
    {
      "name": "rawTotal",
      "update": "data('rawTotal').length ? max(1, data('rawTotal')[0].t) : 1"
    },
    {
      "name": "maxPerStage",
      "update": "max(1, data('stageCounts').length ? data('stageCounts')[0].most : 1)"
    },
    {
      "name": "total",
      "update": "data('stageTotal').length ? data('stageTotal')[0].t : 1"
    },
    {
      "name": "minPx",
      "value": 12
    },
    {
      "name": "yRange",
      "update": "max(10, height - head - gap * (maxPerStage - 1))"
    },
    {
      "name": "pxPerEvent",
      "update": "length(data('kfit2')) ? data('kfit2')[0].k : 0"
    },
    {
      "name": "k1",
      "update": "length(data('kfit1')) ? data('kfit1')[0].k : 0"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "%type%": "esql",
        "query": "FROM logs-elastic_cloud.serverless_audit.otel-default | WHERE @timestamp <= ?_tend AND @timestamp > ?_tstart | WHERE service.name == \"serverless-kibana\" | STATS events = COUNT(*) BY authentication.type, user.domain, kibana.space.id, kibana.saved_object.type, event.action | WHERE (kibana.saved_object.type IS NOT NULL OR event.action LIKE \"ml_*\" OR event.action LIKE \"workflow_*\" OR event.action LIKE \"agent_builder_*\" OR event.action LIKE \"product_documentation_*\" OR event.action == \"secret_create\") | EVAL credential = COALESCE(authentication.type, user.domain, \"unknown\") | EVAL verb = CASE(event.action LIKE \"*_execution_cancel\", \"cancel\", event.action LIKE \"*_run_soon\", \"run\", event.action LIKE \"*_run\", \"run\", event.action LIKE \"*_test\", \"test\", event.action LIKE \"*_enable\", \"enable\", event.action LIKE \"*_disable\", \"disable\", event.action LIKE \"ml_put_*\", \"create\", event.action LIKE \"ml_open_*\", \"open\", event.action LIKE \"ml_start_*\", \"start\", event.action LIKE \"*point_in_time\", \"pit\", event.action LIKE \"*_create*\", \"create\", event.action LIKE \"*_update*\", \"update\", event.action LIKE \"*_delete\", \"delete\", event.action LIKE \"*_find\", \"find\", event.action LIKE \"*_get\", \"get\", event.action LIKE \"*_resolve\", \"resolve\", \"other\") | EVAL obj_type = CASE(kibana.saved_object.type IS NOT NULL, kibana.saved_object.type, event.action LIKE \"ml_*ad_job\", \"ml-job\", event.action LIKE \"ml_*ad_datafeed\", \"ml-datafeed\", event.action LIKE \"workflow_execution_*\", \"workflow-execution\", event.action LIKE \"workflow_*\", \"workflow\", event.action LIKE \"agent_builder_agent_*\", \"agent-builder-agent\", event.action LIKE \"agent_builder_tool_*\", \"agent-builder-tool\", event.action LIKE \"product_documentation_*\", \"product-documentation\", event.action == \"secret_create\", \"secret\", event.action IS NULL, \"unclassified\", REPLACE(event.action, \"_(create|update|delete|enable|disable|run|run_soon|test|cancel)$\", \"\")) | EVAL space = COALESCE(kibana.space.id, \"no space\") | STATS events = SUM(events) BY credential, space, obj_type, verb | SORT events DESC | LIMIT 10000",
        "%timefield%": "@timestamp",
        "%context%": true
      }
    },
    {
      "name": "rawTotal",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "events"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "t"
          ]
        }
      ]
    },
    {
      "name": "fold_credential",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "credential"
          ],
          "fields": [
            "events"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "v"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": "v",
            "order": "descending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "r"
          ]
        },
        {
          "type": "formula",
          "as": "keep",
          "expr": "datum.r < foldK ? 1 : 0"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "keep"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "nKeep"
          ]
        },
        {
          "type": "joinaggregate",
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.keep === 1 || datum.n - datum.nKeep === 1 ? datum['credential'] : 'other (' + (datum.n - datum.nKeep) + ')'"
        }
      ]
    },
    {
      "name": "fold_space",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "space"
          ],
          "fields": [
            "events"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "v"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": "v",
            "order": "descending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "r"
          ]
        },
        {
          "type": "formula",
          "as": "keep",
          "expr": "datum.r < foldK ? 1 : 0"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "keep"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "nKeep"
          ]
        },
        {
          "type": "joinaggregate",
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.keep === 1 || datum.n - datum.nKeep === 1 ? datum['space'] : 'other (' + (datum.n - datum.nKeep) + ')'"
        }
      ]
    },
    {
      "name": "fold_obj_type",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "obj_type"
          ],
          "fields": [
            "events"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "v"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": "v",
            "order": "descending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "r"
          ]
        },
        {
          "type": "formula",
          "as": "keep",
          "expr": "datum.r < foldK ? 1 : 0"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "keep"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "nKeep"
          ]
        },
        {
          "type": "joinaggregate",
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.keep === 1 || datum.n - datum.nKeep === 1 ? datum['obj_type'] : 'other (' + (datum.n - datum.nKeep) + ')'"
        }
      ]
    },
    {
      "name": "fold_verb",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "verb"
          ],
          "fields": [
            "events"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "v"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": "v",
            "order": "descending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "r"
          ]
        },
        {
          "type": "formula",
          "as": "keep",
          "expr": "datum.r < foldK ? 1 : 0"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "keep"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "nKeep"
          ]
        },
        {
          "type": "joinaggregate",
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.keep === 1 || datum.n - datum.nKeep === 1 ? datum['verb'] : 'other (' + (datum.n - datum.nKeep) + ')'"
        }
      ]
    },
    {
      "name": "folded",
      "source": "raw",
      "transform": [
        {
          "type": "lookup",
          "from": "fold_credential",
          "key": "credential",
          "fields": [
            "credential"
          ],
          "values": [
            "name"
          ],
          "as": [
            "credF"
          ]
        },
        {
          "type": "lookup",
          "from": "fold_space",
          "key": "space",
          "fields": [
            "space"
          ],
          "values": [
            "name"
          ],
          "as": [
            "spaceF"
          ]
        },
        {
          "type": "lookup",
          "from": "fold_obj_type",
          "key": "obj_type",
          "fields": [
            "obj_type"
          ],
          "values": [
            "name"
          ],
          "as": [
            "typeF"
          ]
        },
        {
          "type": "lookup",
          "from": "fold_verb",
          "key": "verb",
          "fields": [
            "verb"
          ],
          "values": [
            "name"
          ],
          "as": [
            "verbF"
          ]
        }
      ]
    },
    {
      "name": "l0",
      "source": "folded",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "credF",
            "spaceF"
          ],
          "fields": [
            "events"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "value"
          ]
        },
        {
          "type": "formula",
          "as": "stage",
          "expr": "0"
        },
        {
          "type": "formula",
          "as": "src",
          "expr": "'0|' + datum.credF"
        },
        {
          "type": "formula",
          "as": "dst",
          "expr": "'1|' + datum.spaceF"
        }
      ]
    },
    {
      "name": "l1",
      "source": "folded",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "spaceF",
            "typeF"
          ],
          "fields": [
            "events"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "value"
          ]
        },
        {
          "type": "formula",
          "as": "stage",
          "expr": "1"
        },
        {
          "type": "formula",
          "as": "src",
          "expr": "'1|' + datum.spaceF"
        },
        {
          "type": "formula",
          "as": "dst",
          "expr": "'2|' + datum.typeF"
        }
      ]
    },
    {
      "name": "l2",
      "source": "folded",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "typeF",
            "verbF"
          ],
          "fields": [
            "events"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "value"
          ]
        },
        {
          "type": "formula",
          "as": "stage",
          "expr": "2"
        },
        {
          "type": "formula",
          "as": "src",
          "expr": "'2|' + datum.typeF"
        },
        {
          "type": "formula",
          "as": "dst",
          "expr": "'3|' + datum.verbF"
        }
      ]
    },
    {
      "name": "links",
      "source": [
        "l0",
        "l1",
        "l2"
      ]
    },
    {
      "name": "outs",
      "source": "links",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "src"
          ],
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "v"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum.src"
        }
      ]
    },
    {
      "name": "ins",
      "source": "links",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "dst"
          ],
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "v"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum.dst"
        }
      ]
    },
    {
      "name": "nodes",
      "source": [
        "outs",
        "ins"
      ],
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "key"
          ],
          "fields": [
            "v"
          ],
          "ops": [
            "max"
          ],
          "as": [
            "value"
          ]
        },
        {
          "type": "formula",
          "as": "stage",
          "expr": "toNumber(split(datum.key, '|')[0])"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "slice(datum.key, indexof(datum.key, '|') + 1)"
        },
        {
          "type": "formula",
          "as": "isOther",
          "expr": "indexof(datum.label, 'other (') === 0 ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "display",
          "expr": "datum.stage !== 0 ? datum.label : datum.label === '_cloud_api_key' ? 'Cloud API key' : datum.label === '_es_api_key' ? 'Elasticsearch API key' : datum.label === 'cloud-saml-kibana' ? 'SAML SSO' : datum.label === 'api_key' ? 'API key' : datum.label === 'token' ? 'Token' : datum.label === 'realm' ? 'Realm' : datum.label === 'saml' ? 'SAML' : datum.label === 'anonymous' ? 'Anonymous' : datum.label === 'internal' ? 'Internal' : indexof(datum.label, '_service_account') === 0 ? 'Service account' : datum.label"
        },
        {
          "type": "stack",
          "groupby": [
            "stage"
          ],
          "field": "value",
          "sort": {
            "field": [
              "isOther",
              "value"
            ],
            "order": [
              "ascending",
              "descending"
            ]
          },
          "as": [
            "y0",
            "y1"
          ]
        },
        {
          "type": "window",
          "groupby": [
            "stage"
          ],
          "sort": {
            "field": [
              "isOther",
              "value"
            ],
            "order": [
              "ascending",
              "descending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "formula",
          "as": "rank",
          "expr": "datum.rank - 1"
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "stage"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "nInStage"
          ]
        }
      ]
    },
    {
      "name": "kfit1",
      "source": "nodes",
      "transform": [
        {
          "type": "formula",
          "as": "small",
          "expr": "datum.value * yRange / max(1, total) < minPx ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "vSmall",
          "expr": "datum.small ? datum.value : 0"
        },
        {
          "type": "aggregate",
          "groupby": [
            "stage"
          ],
          "fields": [
            "small",
            "vSmall",
            "value"
          ],
          "ops": [
            "sum",
            "sum",
            "sum"
          ],
          "as": [
            "nSmall",
            "vSmall",
            "v"
          ]
        },
        {
          "type": "formula",
          "as": "k",
          "expr": "datum.v - datum.vSmall > 0 ? max(0, yRange - minPx * datum.nSmall) / (datum.v - datum.vSmall) : 0"
        },
        {
          "type": "aggregate",
          "fields": [
            "k"
          ],
          "ops": [
            "min"
          ],
          "as": [
            "k"
          ]
        }
      ]
    },
    {
      "name": "kfit2",
      "source": "nodes",
      "transform": [
        {
          "type": "formula",
          "as": "small",
          "expr": "datum.value * k1 < minPx ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "vSmall",
          "expr": "datum.small ? datum.value : 0"
        },
        {
          "type": "aggregate",
          "groupby": [
            "stage"
          ],
          "fields": [
            "small",
            "vSmall",
            "value"
          ],
          "ops": [
            "sum",
            "sum",
            "sum"
          ],
          "as": [
            "nSmall",
            "vSmall",
            "v"
          ]
        },
        {
          "type": "formula",
          "as": "k",
          "expr": "datum.v - datum.vSmall > 0 ? max(0, yRange - minPx * datum.nSmall) / (datum.v - datum.vSmall) : 0"
        },
        {
          "type": "aggregate",
          "fields": [
            "k"
          ],
          "ops": [
            "min"
          ],
          "as": [
            "k"
          ]
        }
      ]
    },
    {
      "name": "layout",
      "source": "nodes",
      "transform": [
        {
          "type": "formula",
          "as": "px",
          "expr": "max(minPx, datum.value * pxPerEvent)"
        },
        {
          "type": "stack",
          "groupby": [
            "stage"
          ],
          "field": "px",
          "sort": {
            "field": [
              "isOther",
              "value"
            ],
            "order": [
              "ascending",
              "descending"
            ]
          },
          "as": [
            "py0",
            "py1"
          ]
        }
      ]
    },
    {
      "name": "stageCounts",
      "source": "nodes",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "stage"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "aggregate",
          "fields": [
            "n"
          ],
          "ops": [
            "max"
          ],
          "as": [
            "most"
          ]
        }
      ]
    },
    {
      "name": "stageTotal",
      "source": "l0",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "t"
          ]
        }
      ]
    },
    {
      "name": "ribbons",
      "source": "links",
      "transform": [
        {
          "type": "lookup",
          "from": "layout",
          "key": "key",
          "fields": [
            "src"
          ],
          "values": [
            "py0",
            "px",
            "value",
            "rank"
          ],
          "as": [
            "srcPy0",
            "srcPx",
            "srcV",
            "srcRank"
          ]
        },
        {
          "type": "lookup",
          "from": "layout",
          "key": "key",
          "fields": [
            "dst"
          ],
          "values": [
            "py0",
            "px",
            "value",
            "rank"
          ],
          "as": [
            "dstPy0",
            "dstPx",
            "dstV",
            "dstRank"
          ]
        },
        {
          "type": "stack",
          "groupby": [
            "src"
          ],
          "field": "value",
          "sort": {
            "field": [
              "dstPy0"
            ],
            "order": [
              "ascending"
            ]
          },
          "as": [
            "sy0",
            "sy1"
          ]
        },
        {
          "type": "stack",
          "groupby": [
            "dst"
          ],
          "field": "value",
          "sort": {
            "field": [
              "srcPy0"
            ],
            "order": [
              "ascending"
            ]
          },
          "as": [
            "ty0",
            "ty1"
          ]
        },
        {
          "type": "formula",
          "as": "x1",
          "expr": "scale('x', datum.stage) + nodeW"
        },
        {
          "type": "formula",
          "as": "x2",
          "expr": "scale('x', datum.stage + 1)"
        },
        {
          "type": "formula",
          "as": "xm",
          "expr": "(datum.x1 + datum.x2) / 2"
        },
        {
          "type": "formula",
          "as": "s0",
          "expr": "head + datum.srcPy0 + datum.sy0 * datum.srcPx / max(1, datum.srcV) + datum.srcRank * gap"
        },
        {
          "type": "formula",
          "as": "s1",
          "expr": "max(datum.s0 + 1, head + datum.srcPy0 + datum.sy1 * datum.srcPx / max(1, datum.srcV) + datum.srcRank * gap)"
        },
        {
          "type": "formula",
          "as": "t0",
          "expr": "head + datum.dstPy0 + datum.ty0 * datum.dstPx / max(1, datum.dstV) + datum.dstRank * gap"
        },
        {
          "type": "formula",
          "as": "t1",
          "expr": "max(datum.t0 + 1, head + datum.dstPy0 + datum.ty1 * datum.dstPx / max(1, datum.dstV) + datum.dstRank * gap)"
        },
        {
          "type": "formula",
          "as": "shape",
          "expr": "'M' + datum.x1 + ',' + datum.s0 + 'C' + datum.xm + ',' + datum.s0 + ' ' + datum.xm + ',' + datum.t0 + ' ' + datum.x2 + ',' + datum.t0 + 'L' + datum.x2 + ',' + datum.t1 + 'C' + datum.xm + ',' + datum.t1 + ' ' + datum.xm + ',' + datum.s1 + ' ' + datum.x1 + ',' + datum.s1 + 'Z'"
        }
      ]
    },
    {
      "name": "stageNames",
      "values": [
        {
          "stage": 0,
          "name": "Credential"
        },
        {
          "stage": 1,
          "name": "Space"
        },
        {
          "stage": 2,
          "name": "Object type"
        },
        {
          "stage": 3,
          "name": "Operation"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": [
        0,
        3
      ],
      "range": [
        0,
        {
          "signal": "width - nodeW"
        }
      ]
    },
    {
      "name": "stageColor",
      "type": "ordinal",
      "domain": [
        0,
        1,
        2,
        3
      ],
      "range": [
        "#3987e5",
        "#199e70",
        "#c98500",
        "#d55181"
      ]
    },
    {
      "name": "stageFaint",
      "type": "ordinal",
      "domain": [
        0,
        1,
        2,
        3
      ],
      "range": [
        "rgba(57,135,229,0.4)",
        "rgba(25,158,112,0.4)",
        "rgba(201,133,0,0.4)",
        "rgba(213,81,129,0.4)"
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "style": "guide-title",
      "interactive": false,
      "from": {
        "data": "stageNames"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.stage === 3 ? scale('x', 3) + nodeW : scale('x', datum.stage)"
          },
          "align": {
            "signal": "datum.stage === 3 ? 'right' : 'left'"
          },
          "y": {
            "value": 2
          },
          "baseline": {
            "value": "top"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "text": {
            "field": "name"
          }
        }
      }
    },
    {
      "type": "path",
      "from": {
        "data": "ribbons"
      },
      "encode": {
        "update": {
          "path": {
            "field": "shape"
          },
          "fill": {
            "signal": "{gradient: 'linear', x1: 0, y1: 0, x2: 1, y2: 0, stops: datum.stage === 2 ? [{offset: 0, color: scale('stageFaint', datum.stage)}, {offset: min(0.4, 125 / max(1, datum.x2 - datum.x1)), color: scale('stageFaint', datum.stage)}, {offset: min(0.5, 185 / max(1, datum.x2 - datum.x1)), color: scale('stageColor', datum.stage)}, {offset: 1 - min(0.5, 185 / max(1, datum.x2 - datum.x1)), color: scale('stageColor', datum.stage)}, {offset: 1 - min(0.4, 125 / max(1, datum.x2 - datum.x1)), color: scale('stageFaint', datum.stage)}, {offset: 1, color: scale('stageFaint', datum.stage)}] : [{offset: 0, color: scale('stageFaint', datum.stage)}, {offset: min(0.4, 125 / max(1, datum.x2 - datum.x1)), color: scale('stageFaint', datum.stage)}, {offset: min(0.5, 185 / max(1, datum.x2 - datum.x1)), color: scale('stageColor', datum.stage)}, {offset: 1, color: scale('stageColor', datum.stage)}]}"
          },
          "fillOpacity": {
            "signal": "hoverKey == null ? 0.3 : (datum.src === hoverKey || datum.dst === hoverKey ? 0.7 : 0.06)"
          },
          "tooltip": {
            "signal": "{'From': slice(datum.src, 2), 'To': slice(datum.dst, 2), 'Events': format(datum.value, ',')}"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "node",
      "from": {
        "data": "layout"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "stage"
          },
          "width": {
            "signal": "nodeW"
          },
          "y": {
            "signal": "head + datum.py0 + datum.rank * gap"
          },
          "y2": {
            "signal": "head + datum.py1 + datum.rank * gap"
          },
          "fill": {
            "scale": "stageColor",
            "field": "stage"
          },
          "cursor": {
            "signal": "indexof(datum.label, 'other (') !== 0 && ((datum.stage === 0 && datum.label !== 'unknown') || (datum.stage === 1 && datum.label !== 'no space')) ? 'pointer' : 'default'"
          },
          "tooltip": {
            "signal": "{'Stage': ['credential', 'space', 'object type', 'operation'][datum.stage], 'Value': datum.display === datum.label ? datum.label : datum.display + ' (' + datum.label + ')', 'Events': format(datum.value, ','), 'Click': indexof(datum.label, 'other (') === 0 ? 'several smaller values, folded together — hover the ribbons for each' : (datum.stage === 0 && datum.label !== 'unknown') || (datum.stage === 1 && datum.label !== 'no space') ? 'pin across the suite' : 'derived — cannot be pinned'}"
          }
        }
      }
    },
    {
      "type": "text",
      "style": "guide-label",
      "from": {
        "data": "layout"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.stage === 3 ? scale('x', 3) - 4 : scale('x', datum.stage) + nodeW + 4"
          },
          "align": {
            "signal": "datum.stage === 3 ? 'right' : 'left'"
          },
          "y": {
            "signal": "head + (datum.py0 + datum.py1) / 2 + datum.rank * gap"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "text": {
            "signal": "datum.display + '  ' + format(datum.value, ',')"
          },
          "opacity": {
            "value": 1
          },
          "limit": {
            "signal": "width / 3 - 24"
          }
        }
      }
    },
    {
      "type": "text",
      "style": "guide-label",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "height / 2"
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "value": 12
          },
          "text": {
            "value": "No Kibana activity for this selection in this time range — Elasticsearch API calls do not appear here."
          },
          "opacity": {
            "signal": "length(data('raw')) === 0 ? 1 : 0"
          }
        }
      }
    }
  ]
}
