{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "One bar per Kibana browser session in the last 24 hours, newest first — its length runs from the first to the last thing they did in it and its strength is how much it did, which are independent: a short session can carry far more activity than a long one left open and idle. Click a bar to set the dashboard's time range to that session (plus a minute either side); use the time picker's back arrow to return. Shift-click pins that identity across the suite. What an open browser tab does on its own — internal page requests, usage counters, point-in-time paging — is left out, exactly as in the Session records below, so a tab left open does not stretch a bar past the person's last action and every bar has records under it. Only Kibana audit carries a session id, so an identity that works through the Elasticsearch API has no sessions, and an empty panel for it is the correct answer. Twelve most recent sessions, each labelled with who and when it started. Times are in your browser's timezone, like the rest of Kibana. Fixed 24-hour window: does not follow the time picker.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 4,
  "config": {
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "signals": [
    {
      "name": "lane",
      "update": "length(data('sessions')) ? max(10, min(30, height / length(data('sessions')))) : 12"
    },
    {
      "name": "zoomTo",
      "value": null,
      "on": [
        {
          "events": "@ribbon:click[!event.shiftKey]",
          "update": "kibanaSetTimeFilter(datum.start - 60000, datum.end + 60000)"
        }
      ]
    },
    {
      "name": "pinActor",
      "value": null,
      "on": [
        {
          "events": "@ribbon:click[event.shiftKey]",
          "update": "datum.actor === 'no email recorded' ? null : kibanaAddFilter({match_phrase: {'attributes.user.email': datum.actor}}, 'logs-elastic_cloud.serverless_audit.otel-default', 'actor: ' + datum.actor)"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "sessions",
      "url": {
        "index": "logs-elastic_cloud.serverless_audit.otel-default",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": "now-24h",
                      "lte": "now"
                    }
                  }
                },
                {
                  "exists": {
                    "field": "attributes.kibana.session.id"
                  }
                },
                {
                  "bool": {
                    "must_not": [
                      {
                        "terms": {
                          "attributes.event.action": [
                            "saved_object_open_point_in_time",
                            "saved_object_close_point_in_time"
                          ]
                        }
                      },
                      {
                        "bool": {
                          "filter": [
                            {
                              "term": {
                                "attributes.event.action": "http_request"
                              }
                            }
                          ],
                          "should": [
                            {
                              "bool": {
                                "must_not": [
                                  {
                                    "wildcard": {
                                      "attributes.url.original": "*/api/*"
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "wildcard": {
                                "attributes.url.original": "*/api/ui_counters/*"
                              }
                            },
                            {
                              "wildcard": {
                                "attributes.url.original": "*/api/content_management/*"
                              }
                            }
                          ],
                          "minimum_should_match": 1
                        }
                      }
                    ]
                  }
                }
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ]
            }
          },
          "aggs": {
            "sessions": {
              "terms": {
                "field": "attributes.kibana.session.id",
                "size": 12,
                "order": {
                  "last": "desc"
                }
              },
              "aggs": {
                "first": {
                  "min": {
                    "field": "@timestamp"
                  }
                },
                "last": {
                  "max": {
                    "field": "@timestamp"
                  }
                },
                "who": {
                  "terms": {
                    "field": "attributes.user.email",
                    "size": 1
                  }
                },
                "actions": {
                  "cardinality": {
                    "field": "attributes.event.action",
                    "precision_threshold": 100
                  }
                },
                "spaces": {
                  "terms": {
                    "field": "attributes.kibana.space.id",
                    "size": 5
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.sessions.buckets"
      },
      "transform": [
        {
          "type": "formula",
          "as": "start",
          "expr": "datum.first.value"
        },
        {
          "type": "formula",
          "as": "end",
          "expr": "datum.last.value"
        },
        {
          "type": "formula",
          "as": "events",
          "expr": "datum.doc_count"
        },
        {
          "type": "formula",
          "as": "nActions",
          "expr": "datum.actions.value"
        },
        {
          "type": "formula",
          "as": "actor",
          "expr": "length(datum.who.buckets) ? datum.who.buckets[0].key : 'no email recorded'"
        },
        {
          "type": "formula",
          "as": "base",
          "expr": "datum.actor + ' · from ' + timeFormat(datum.first.value, '%H:%M')"
        },
        {
          "type": "window",
          "groupby": [
            "base"
          ],
          "sort": {
            "field": "key"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "dup"
          ]
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "base"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "dupN"
          ]
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.dupN > 1 ? datum.base + ' (' + datum.dup + ')' : datum.base"
        },
        {
          "type": "formula",
          "as": "minutes",
          "expr": "(datum.end - datum.start) / 60000"
        },
        {
          "type": "formula",
          "as": "spaceList",
          "expr": "join(pluck(datum.spaces.buckets, 'key'), ', ')"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "time",
      "domain": {
        "signal": "[now() - 86400000, now()]"
      },
      "range": "width"
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "sessions",
        "field": "label",
        "sort": {
          "field": "end",
          "op": "max",
          "order": "descending"
        }
      },
      "range": {
        "step": {
          "signal": "lane"
        }
      },
      "paddingInner": 0.25
    },
    {
      "name": "strength",
      "type": "log",
      "domain": {
        "data": "sessions",
        "field": "events"
      },
      "range": [
        "#54B399",
        "#6092C0",
        "#9170B8",
        "#D36086"
      ],
      "interpolate": "hcl"
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "format": "%H:%M",
      "tickCount": 8,
      "grid": true,
      "gridOpacity": 0.3,
      "labelOverlap": true
    },
    {
      "orient": "left",
      "scale": "y",
      "ticks": false,
      "domain": false,
      "labelLimit": 240,
      "labelFontSize": 12
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "ribbon",
      "from": {
        "data": "sessions"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "start"
          },
          "x2": {
            "signal": "max(scale('x', datum.start) + 4, scale('x', datum.end))"
          },
          "y": {
            "scale": "y",
            "field": "label"
          },
          "height": {
            "scale": "y",
            "band": 1
          },
          "fill": {
            "scale": "strength",
            "field": "events"
          },
          "fillOpacity": {
            "value": 0.85
          },
          "cornerRadius": {
            "value": 2
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Identity': datum.actor, 'Session': slice(datum.key, 0, 12) + '…', 'Started': timeFormat(datum.start, '%a %d %b, %H:%M'), 'Ended': timeFormat(datum.end, '%a %d %b, %H:%M'), 'Duration': datum.minutes < 90 ? format(datum.minutes, '.0f') + ' min' : format(datum.minutes / 60, '.1f') + ' h', 'Events': format(datum.events, ','), 'Distinct actions': datum.nActions, 'Spaces': datum.spaceList, 'Click': 'zoom the dashboard to this session', 'Shift-click': 'pin this identity'}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "style": "guide-label",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "height / 2"
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "value": 12
          },
          "text": {
            "value": "No Kibana browser sessions for this selection in the last 24 hours — Elasticsearch API calls carry no session id."
          },
          "opacity": {
            "signal": "length(data('sessions')) === 0 ? 1 : 0"
          }
        }
      }
    }
  ]
}
