{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "One bar per Kibana browser session in the last 24 hours, newest first — its length runs from the first to the last thing they did in it and its strength is how much it did, which are independent: a short session can carry far more activity than a long one left open and idle. Click a bar to filter the dashboard to that session (a \"session: …\" pill on attributes.kibana.session.id) and to set the time range to the session plus a minute either side, so the session records directly below this timeline show exactly that session's events: those records follow the time picker, while this timeline stays on its fixed 24 hours. To return, remove the pill and set the time range again. The pill narrows every panel on the page to that session, so a panel of Elasticsearch events, which carry no session id, reads empty while it is on. Shift-click pins that identity by email across the suite instead. What an open browser tab does on its own — internal page requests, usage counters, point-in-time paging — is left out, exactly as in the session records below, so a tab left open does not stretch a bar past the person's last action and every bar has records under it. Only Kibana browser sign-ins carry a session id: work through an API key or the Elasticsearch API has no session and draws no bar, so the dashed line marks the latest such event in the same 24 hours — activity after the last bar is real, it is just not a session. An identity that only works through the API has no bars, and that is the correct answer. Twelve most recent sessions, each labelled with who and when it started (with the weekday when that was not today); a session already open when the 24-hour window begins starts at the window's left edge and is labelled \"or earlier\", because its real start is outside the window. Times are in your browser's timezone, like the rest of Kibana. Fixed 24-hour window: does not follow the time picker.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 4,
  "config": {
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "signals": [
    {
      "name": "lane",
      "update": "length(data('sessions')) ? max(10, min(44, height / max(3, length(data('sessions'))))) : 12"
    },
    {
      "name": "zoomTo",
      "value": null,
      "on": [
        {
          "events": "@ribbon:click[!event.shiftKey]",
          "update": "{s: datum.start - 60000, e: datum.end + 60000, t: now(), n: 0}"
        },
        {
          "events": {
            "type": "timer",
            "throttle": 100
          },
          "update": "!zoomTo ? null : zoomTo.n === 0 && now() - zoomTo.t > 700 ? (kibanaSetTimeFilter(zoomTo.s, zoomTo.e) ? null : {s: zoomTo.s, e: zoomTo.e, t: zoomTo.t, n: 1}) : zoomTo.n === 1 && now() - zoomTo.t > 1400 ? (kibanaSetTimeFilter(zoomTo.s, zoomTo.e) ? null : null) : zoomTo"
        }
      ]
    },
    {
      "name": "pinSession",
      "value": null,
      "on": [
        {
          "events": "@ribbon:click[!event.shiftKey]",
          "update": "kibanaAddFilter({match_phrase: {'attributes.kibana.session.id': datum.key}}, 'logs-elastic_cloud.serverless_audit.otel-default', 'session: ' + slice(datum.key, 0, 8) + '…')"
        }
      ]
    },
    {
      "name": "pinActor",
      "value": null,
      "on": [
        {
          "events": "@ribbon:click[event.shiftKey]",
          "update": "datum.actor === 'no email recorded' ? null : kibanaAddFilter({match_phrase: {'attributes.user.email': datum.actor}}, 'logs-elastic_cloud.serverless_audit.otel-default', 'actor: ' + datum.actor)"
        }
      ]
    },
    {
      "name": "noSess",
      "update": "length(data('nosession')) ? data('nosession')[0].t : null"
    }
  ],
  "data": [
    {
      "name": "sessions",
      "url": {
        "index": "logs-elastic_cloud.serverless_audit.otel-default",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": "now-24h",
                      "lte": "now"
                    }
                  }
                },
                {
                  "exists": {
                    "field": "attributes.kibana.session.id"
                  }
                },
                {
                  "bool": {
                    "must_not": [
                      {
                        "terms": {
                          "attributes.event.action": [
                            "saved_object_open_point_in_time",
                            "saved_object_close_point_in_time"
                          ]
                        }
                      },
                      {
                        "bool": {
                          "filter": [
                            {
                              "term": {
                                "attributes.event.action": "http_request"
                              }
                            }
                          ],
                          "should": [
                            {
                              "bool": {
                                "must_not": [
                                  {
                                    "wildcard": {
                                      "attributes.url.original": "*/api/*"
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "wildcard": {
                                "attributes.url.original": "*/api/ui_counters/*"
                              }
                            },
                            {
                              "wildcard": {
                                "attributes.url.original": "*/api/content_management/*"
                              }
                            }
                          ],
                          "minimum_should_match": 1
                        }
                      }
                    ]
                  }
                }
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ]
            }
          },
          "aggs": {
            "sessions": {
              "terms": {
                "field": "attributes.kibana.session.id",
                "size": 12,
                "order": {
                  "last": "desc"
                }
              },
              "aggs": {
                "first": {
                  "min": {
                    "field": "@timestamp"
                  }
                },
                "last": {
                  "max": {
                    "field": "@timestamp"
                  }
                },
                "who": {
                  "terms": {
                    "field": "attributes.user.email",
                    "size": 1
                  }
                },
                "actions": {
                  "cardinality": {
                    "field": "attributes.event.action",
                    "precision_threshold": 100
                  }
                },
                "spaces": {
                  "terms": {
                    "field": "attributes.kibana.space.id",
                    "size": 5
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.sessions.buckets"
      },
      "transform": [
        {
          "type": "formula",
          "as": "start",
          "expr": "datum.first.value"
        },
        {
          "type": "formula",
          "as": "end",
          "expr": "datum.last.value"
        },
        {
          "type": "formula",
          "as": "events",
          "expr": "datum.doc_count"
        },
        {
          "type": "formula",
          "as": "nActions",
          "expr": "datum.actions.value"
        },
        {
          "type": "formula",
          "as": "actor",
          "expr": "length(datum.who.buckets) ? datum.who.buckets[0].key : 'no email recorded'"
        },
        {
          "type": "formula",
          "as": "base",
          "expr": "datum.actor + ' · from ' + timeFormat(datum.first.value, timeFormat(datum.first.value, '%a') === timeFormat(now(), '%a') ? '%H:%M' : '%a %H:%M') + (datum.first.value < now() - 86400000 + 600000 ? ' or earlier' : '')"
        },
        {
          "type": "window",
          "groupby": [
            "base"
          ],
          "sort": {
            "field": "key"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "dup"
          ]
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "base"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "dupN"
          ]
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.dupN > 1 ? datum.base + ' (' + datum.dup + ')' : datum.base"
        },
        {
          "type": "formula",
          "as": "minutes",
          "expr": "(datum.end - datum.start) / 60000"
        },
        {
          "type": "formula",
          "as": "spaceList",
          "expr": "join(pluck(datum.spaces.buckets, 'key'), ', ')"
        }
      ]
    },
    {
      "name": "nosession",
      "url": {
        "index": "logs-elastic_cloud.serverless_audit.otel-default",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": "now-24h",
                      "lte": "now"
                    }
                  }
                }
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%",
                {
                  "exists": {
                    "field": "attributes.kibana.session.id"
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ]
            }
          },
          "aggs": {
            "last": {
              "max": {
                "field": "@timestamp"
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      },
      "transform": [
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.last.value"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.t) && datum.t > now() - 86400000"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "time",
      "domain": {
        "signal": "[now() - 86400000, now()]"
      },
      "range": "width"
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "sessions",
        "field": "label",
        "sort": {
          "field": "end",
          "op": "max",
          "order": "descending"
        }
      },
      "range": {
        "step": {
          "signal": "lane"
        }
      },
      "paddingInner": 0.25
    },
    {
      "name": "strength",
      "type": "log",
      "domain": {
        "data": "sessions",
        "field": "events"
      },
      "range": [
        "#54B399",
        "#6092C0",
        "#9170B8",
        "#D36086"
      ],
      "interpolate": "hcl"
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "format": "%H:%M",
      "tickCount": 8,
      "grid": true,
      "gridOpacity": 0.3,
      "labelOverlap": true
    },
    {
      "orient": "left",
      "scale": "y",
      "ticks": false,
      "domain": false,
      "labelLimit": 340,
      "labelPadding": 8,
      "labelFontSize": 12
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "ribbon",
      "from": {
        "data": "sessions"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "start"
          },
          "x2": {
            "signal": "max(scale('x', datum.start) + 4, scale('x', datum.end))"
          },
          "y": {
            "scale": "y",
            "field": "label"
          },
          "height": {
            "scale": "y",
            "band": 1
          },
          "fill": {
            "scale": "strength",
            "field": "events"
          },
          "fillOpacity": {
            "value": 0.85
          },
          "cornerRadius": {
            "value": 2
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Identity': datum.actor, 'Session': slice(datum.key, 0, 12) + '…', 'Started': timeFormat(datum.start, '%a %d %b, %H:%M'), 'Ended': timeFormat(datum.end, '%a %d %b, %H:%M'), 'Duration': datum.minutes < 90 ? format(datum.minutes, '.0f') + ' min' : format(datum.minutes / 60, '.1f') + ' h', 'Events': format(datum.events, ','), 'Distinct actions': datum.nActions, 'Spaces': datum.spaceList, 'Click': 'filter to this session and zoom to it', 'Shift-click': 'pin this identity'}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "style": "guide-label",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "height / 2"
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "value": 12
          },
          "text": {
            "value": "No Kibana browser sessions for this selection in the last 24 hours — Elasticsearch API calls carry no session id."
          },
          "opacity": {
            "signal": "length(data('sessions')) === 0 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "rule",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "noSess ? scale('x', noSess) : -10"
          },
          "y": {
            "value": 0
          },
          "y2": {
            "signal": "height"
          },
          "stroke": {
            "value": "#98A2B3"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "strokeDash": {
            "value": [
              4,
              3
            ]
          },
          "opacity": {
            "signal": "noSess ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "style": "guide-label",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "noSess ? scale('x', noSess) + (scale('x', noSess) > width / 2 ? -6 : 6) : 0"
          },
          "y": {
            "signal": "height - 4"
          },
          "baseline": {
            "value": "bottom"
          },
          "align": {
            "signal": "noSess && scale('x', noSess) > width / 2 ? 'right' : 'left'"
          },
          "fontSize": {
            "value": 12
          },
          "text": {
            "signal": "noSess ? 'latest activity with no session (API key or Elasticsearch API) · ' + timeFormat(noSess, '%H:%M') : ''"
          },
          "opacity": {
            "signal": "noSess ? 1 : 0"
          }
        }
      }
    }
  ]
}
