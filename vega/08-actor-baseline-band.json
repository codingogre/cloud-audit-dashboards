{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Hourly activity over the last 7 days against this selection’s own usual range for each hour of day (the shaded band). A marked point is an hour well outside their usual range. A sanity check, not a detector. UTC.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 4,
  "config": {
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFontSize": 11
    }
  },
  "signals": [
    {
      "name": "head",
      "value": 40
    },
    {
      "name": "quiet",
      "update": "length(data('summary')) === 0 || data('summary')[0].total === 0"
    },
    {
      "name": "xlo",
      "update": "length(data('summary')) ? (data('summary')[0].short && isValid(data('summary')[0].firstActive) ? max(data('summary')[0].firstKey, data('summary')[0].firstActive - 3 * 3600000) : data('summary')[0].firstKey) : 0"
    },
    {
      "name": "xhi",
      "update": "length(data('summary')) ? data('summary')[0].lastKey : 1"
    }
  ],
  "data": [
    {
      "name": "counts",
      "url": {
        "%type%": "esql",
        "%timefield%": "@timestamp",
        "%context%": true,
        "query": "SET unmapped_fields=\"nullify\"; FROM logs-elastic_cloud.serverless_audit.otel-default | WHERE @timestamp <= ?_tend AND @timestamp > ?_tstart AND ((?identity == \"\" OR ?identity == \"Any\") OR user.email == ?identity OR api_key.name == ?identity OR user.name == ?identity OR user.name == REPLACE(REPLACE(?identity, \" · Cloud API key$\", \"\"), \"^Unnamed key of \", \"\") OR (?identity == \"(unattributed)\" AND user.name IS NULL)) AND ((?identity_kind == \"\" OR ?identity_kind == \"Any\") OR (?identity_kind == \"Person\" AND user.email IS NOT NULL) OR (?identity_kind == \"Elasticsearch API key\" AND user.email IS NULL AND api_key.name IS NOT NULL) OR (?identity_kind == \"Elasticsearch API key (name not recorded)\" AND user.email IS NULL AND api_key.name IS NULL AND user.domain == \"_es_api_key\") OR (?identity_kind == \"Cloud API key\" AND user.email IS NULL AND api_key.name IS NULL AND user.domain == \"_cloud_api_key\") OR (?identity_kind == \"Service account\" AND user.email IS NULL AND api_key.name IS NULL AND user.domain == \"_service_account\") OR (?identity_kind == \"Failed sign-in\" AND user.email IS NULL AND api_key.name IS NULL AND (user.domain IS NULL OR NOT user.domain IN (\"_cloud_api_key\",\"_es_api_key\",\"_service_account\")) AND event.action IN (\"authentication_failed\",\"anonymous_access_denied\")) OR (?identity_kind == \"Unattributed\" AND user.email IS NULL AND api_key.name IS NULL AND (user.domain IS NULL OR NOT user.domain IN (\"_cloud_api_key\",\"_es_api_key\",\"_service_account\")) AND (event.action IS NULL OR NOT event.action IN (\"authentication_failed\",\"anonymous_access_denied\")) AND user.name IS NULL) OR (?identity_kind == \"Other\" AND user.email IS NULL AND api_key.name IS NULL AND (user.domain IS NULL OR NOT user.domain IN (\"_cloud_api_key\",\"_es_api_key\",\"_service_account\")) AND (event.action IS NULL OR NOT event.action IN (\"authentication_failed\",\"anonymous_access_denied\")) AND user.name IS NOT NULL)) AND ((?identity == \"\" OR ?identity == \"Any\") OR user.email == ?identity OR (user.email IS NULL AND api_key.name == ?identity) OR (user.email IS NULL AND api_key.name IS NULL AND user.domain == \"_cloud_api_key\" AND user.name == REPLACE(?identity, \" · Cloud API key$\", \"\")) OR (user.email IS NULL AND api_key.name IS NULL AND user.domain == \"_es_api_key\" AND user.name == REPLACE(?identity, \"^Unnamed key of \", \"\")) OR (user.email IS NULL AND api_key.name IS NULL AND (user.domain IS NULL OR NOT user.domain IN (\"_cloud_api_key\",\"_es_api_key\")) AND user.name == ?identity) OR (?identity == \"(unattributed)\" AND user.email IS NULL AND api_key.name IS NULL AND user.name IS NULL)) | STATS doc_count = COUNT(*) BY hour = DATE_TRUNC(1 hour, @timestamp) | EVAL ago = DATE_DIFF(\"hour\", hour, DATE_TRUNC(1 hour, TO_DATETIME(?_tend))) | WHERE ago <= 167 | KEEP ago, doc_count"
      }
    },
    {
      "name": "hours",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": 168,
          "as": "ago"
        },
        {
          "type": "lookup",
          "from": "counts",
          "key": "ago",
          "fields": [
            "ago"
          ],
          "values": [
            "doc_count"
          ],
          "as": [
            "doc_count"
          ],
          "default": 0
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "(floor(now() / 3600000) - datum.ago) * 3600000"
        },
        {
          "type": "collect",
          "sort": {
            "field": "key"
          }
        }
      ]
    },
    {
      "name": "series",
      "source": "hours",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.key + 3600000 <= now()"
        },
        {
          "type": "formula",
          "as": "events",
          "expr": "datum.doc_count"
        },
        {
          "type": "formula",
          "as": "activeKey",
          "expr": "datum.events > 0 ? datum.key : null"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "activeKey",
            "key",
            "key"
          ],
          "ops": [
            "min",
            "max",
            "min"
          ],
          "as": [
            "firstActive",
            "lastKey",
            "firstKey"
          ]
        },
        {
          "type": "formula",
          "as": "short",
          "expr": "datum.lastKey - datum.firstActive < 3 * 86400000"
        },
        {
          "type": "formula",
          "as": "livedEvents",
          "expr": "datum.key >= datum.firstActive ? datum.events : null"
        },
        {
          "type": "formula",
          "as": "slot",
          "expr": "utchours(datum.key)"
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "slot"
          ],
          "fields": [
            "livedEvents",
            "livedEvents",
            "livedEvents"
          ],
          "ops": [
            "q1",
            "median",
            "q3"
          ],
          "as": [
            "q1",
            "med",
            "q3"
          ]
        },
        {
          "type": "formula",
          "as": "hi",
          "expr": "datum.q3 + 1.5 * (datum.q3 - datum.q1)"
        },
        {
          "type": "formula",
          "as": "lo",
          "expr": "max(0, datum.q1 - 1.5 * (datum.q3 - datum.q1))"
        },
        {
          "type": "formula",
          "as": "flag",
          "expr": "datum.short ? 'typical' : datum.events > datum.hi ? 'unusually busy' : datum.events < datum.lo ? 'unusually quiet' : 'typical'"
        },
        {
          "type": "formula",
          "as": "out",
          "expr": "datum.flag === 'typical' ? 0 : 1"
        }
      ]
    },
    {
      "name": "shown",
      "source": "series",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.key >= xlo"
        }
      ]
    },
    {
      "name": "lived",
      "source": "shown",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.firstActive) && datum.key >= datum.firstActive"
        },
        {
          "type": "formula",
          "as": "decade",
          "expr": "datum.events > 0 ? pow(10, floor(log(datum.events) / LN10 + 1e-9)) : 0"
        }
      ]
    },
    {
      "name": "outside",
      "source": "lived",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.out === 1"
        }
      ]
    },
    {
      "name": "summary",
      "source": "series",
      "transform": [
        {
          "type": "window",
          "sort": {
            "field": "key",
            "order": "descending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "recency"
          ]
        },
        {
          "type": "joinaggregate",
          "fields": [
            "out",
            "events"
          ],
          "ops": [
            "sum",
            "sum"
          ],
          "as": [
            "n_out",
            "total"
          ]
        },
        {
          "type": "joinaggregate",
          "ops": [
            "count"
          ],
          "as": [
            "n_hours"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.recency === 1"
        },
        {
          "type": "formula",
          "as": "line1",
          "expr": "datum.total === 0 ? 'No activity for this selection in the last 7 days' : utcFormat(datum.key, '%H:00') + ' UTC (last full hour): ' + format(datum.events, ',') + ' events' + (datum.short ? '' : ', ' + (datum.med > 0 ? format(datum.events / datum.med, '.1f') + '× their median' : 'usually an idle hour'))"
        },
        {
          "type": "formula",
          "as": "line2",
          "expr": "datum.total === 0 ? '' : datum.short ? 'History only since ' + utcFormat(datum.firstActive, '%a %H:00') + ' UTC: too short to judge, so no hour is marked unusual' : datum.n_out + ' of ' + datum.n_hours + ' hours unusual for the time of day'"
        }
      ]
    },
    {
      "name": "bandKey",
      "source": "series",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.short && datum.q3 > datum.q1"
        },
        {
          "type": "aggregate",
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "k",
          "expr": "'typical range'"
        }
      ]
    },
    {
      "name": "flagKeys",
      "source": "outside",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "flag"
          ]
        },
        {
          "type": "formula",
          "as": "k",
          "expr": "datum.flag"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "utc",
      "domain": {
        "signal": "[xlo, xhi]"
      },
      "range": "width"
    },
    {
      "name": "y",
      "type": "symlog",
      "domain": {
        "data": "lived",
        "fields": [
          "events",
          "q1",
          "q3",
          "decade"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        {
          "signal": "head"
        }
      ],
      "zero": false
    },
    {
      "name": "key",
      "type": "ordinal",
      "domain": [
        "typical",
        "unusually busy",
        "unusually quiet"
      ],
      "range": [
        "#5082B1",
        "#d95926",
        "#9085e9"
      ]
    },
    {
      "name": "drawn",
      "type": "ordinal",
      "domain": {
        "fields": [
          {
            "data": "bandKey",
            "field": "k"
          },
          {
            "data": "flagKeys",
            "field": "k"
          }
        ],
        "sort": true
      },
      "range": [
        "#5082B1",
        "#d95926",
        "#9085e9"
      ]
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "tickCount": 7,
      "labelOverlap": true,
      "labelSeparation": 10,
      "grid": false,
      "format": "%a %d",
      "formatType": "utc",
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "xhi - xlo < 2 * 86400000 ? utcFormat(datum.value, '%a %H:00') : utcFormat(datum.value, '%a %d')"
            }
          }
        }
      }
    },
    {
      "orient": "left",
      "scale": "y",
      "grid": true,
      "gridOpacity": 0.4,
      "values": {
        "signal": "slice([0, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000], domain('y')[0] <= 0 ? 0 : ceil(log(domain('y')[0]) / LN10), 2 + floor(log(max(domain('y')[1], 10)) / LN10))"
      },
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "format(datum.value, '~s')"
            },
            "opacity": {
              "signal": "quiet ? 0 : 1"
            }
          }
        },
        "grid": {
          "update": {
            "opacity": {
              "signal": "quiet ? 0 : 1"
            }
          }
        },
        "domain": {
          "update": {
            "opacity": {
              "signal": "quiet ? 0 : 1"
            }
          }
        },
        "ticks": {
          "update": {
            "opacity": {
              "signal": "quiet ? 0 : 1"
            }
          }
        }
      }
    }
  ],
  "legends": [
    {
      "fill": "drawn",
      "orient": "none",
      "legendX": {
        "signal": "width - 10 - 100 * length(domain('drawn'))"
      },
      "legendY": 20,
      "direction": "horizontal",
      "symbolType": "circle",
      "symbolSize": 50,
      "labelLimit": 160,
      "encode": {
        "title": {
          "update": {
            "opacity": {
              "signal": "quiet ? 0 : 1"
            }
          }
        },
        "labels": {
          "update": {
            "opacity": {
              "signal": "quiet ? 0 : 1"
            }
          }
        },
        "symbols": {
          "update": {
            "opacity": {
              "signal": "quiet ? 0 : 1"
            },
            "fill": {
              "signal": "datum.value === 'unusually busy' ? '#d95926' : datum.value === 'unusually quiet' ? '#9085e9' : '#5082B1'"
            },
            "fillOpacity": {
              "signal": "datum.value === 'typical range' ? 0.45 : 1"
            },
            "shape": {
              "signal": "datum.value === 'typical range' ? 'square' : 'circle'"
            },
            "strokeWidth": {
              "value": 0
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "type": "area",
      "from": {
        "data": "lived"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "key"
          },
          "y": {
            "scale": "y",
            "field": "q1"
          },
          "y2": {
            "scale": "y",
            "field": "q3"
          },
          "interpolate": {
            "value": "step-after"
          },
          "fill": {
            "value": "#5082B1"
          },
          "fillOpacity": {
            "signal": "quiet || datum.short ? 0 : 0.35"
          }
        }
      }
    },
    {
      "type": "line",
      "from": {
        "data": "lived"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "key"
          },
          "y": {
            "scale": "y",
            "field": "events"
          },
          "stroke": {
            "value": "#3987e5"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "strokeOpacity": {
            "signal": "quiet ? 0 : 1"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "outside"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "key"
          },
          "y": {
            "scale": "y",
            "field": "events"
          },
          "size": {
            "value": 42
          },
          "fill": {
            "scale": "key",
            "field": "flag"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "lived"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "key"
          },
          "y": {
            "scale": "y",
            "field": "events"
          },
          "size": {
            "value": 120
          },
          "fill": {
            "value": "#3987e5"
          },
          "fillOpacity": {
            "value": 0
          },
          "tooltip": {
            "signal": "{'Hour': utcFormat(datum.key, '%a %d %b, %H:00') + ' UTC', 'Events': format(datum.events, ','), 'Typical for this hour': format(datum.q1, ',.0f') + ' – ' + format(datum.q3, ',.0f'), 'Unusual beyond': format(datum.lo, ',.0f') + ' – ' + format(datum.hi, ',.0f'), 'Reading': datum.flag}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "summary"
      },
      "style": "guide-title",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 2
          },
          "baseline": {
            "value": "top"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "text": {
            "field": "line1"
          },
          "limit": {
            "signal": "width"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "summary"
      },
      "style": "guide-label",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 20
          },
          "baseline": {
            "value": "top"
          },
          "fontSize": {
            "value": 11
          },
          "text": {
            "field": "line2"
          },
          "limit": {
            "signal": "width - 20 - 100 * length(domain('drawn'))"
          }
        }
      }
    }
  ]
}
