{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "How far back the audit stream goes: its first event and the days since, with the retention set on the data stream when the suite was installed. Generated by coverageSpec() in scripts/lib/panels.mjs: do not edit.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "signals": [
    {
      "name": "pad",
      "value": 8
    },
    {
      "name": "retention",
      "value": "Retention not checked"
    }
  ],
  "data": [
    {
      "name": "tile",
      "url": {
        "index": "logs-elastic_cloud.serverless_audit.otel-default",
        "body": {
          "size": 0,
          "track_total_hits": false,
          "query": {
            "bool": {
              "filter": [
                {
                  "range": {
                    "@timestamp": {
                      "gte": "now-100y",
                      "lte": "now"
                    }
                  }
                }
              ]
            }
          },
          "aggs": {
            "first": {
              "min": {
                "field": "@timestamp"
              }
            },
            "last": {
              "max": {
                "field": "@timestamp"
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      },
      "transform": [
        {
          "type": "formula",
          "as": "t0",
          "expr": "datum.first.value"
        },
        {
          "type": "formula",
          "as": "days",
          "expr": "isValid(datum.t0) ? (datum.last.value - datum.t0) / 864e5 : 0"
        },
        {
          "type": "formula",
          "as": "value",
          "expr": "!isValid(datum.t0) ? 'none yet' : datum.days < 1 ? format(datum.days * 24, '.1f') + ' hours' : format(datum.days, '.1f') + ' days'"
        },
        {
          "type": "formula",
          "as": "detail",
          "expr": "isValid(datum.t0) ? 'since ' + timeFormat(datum.t0, '%b %-d, %Y @ %H:%M') : ''"
        },
        {
          "type": "formula",
          "as": "note",
          "expr": "retention"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "theme",
      "style": "guide-label",
      "encode": {
        "enter": {
          "text": {
            "value": ""
          },
          "opacity": {
            "value": 0
          }
        }
      }
    },
    {
      "type": "text",
      "name": "title",
      "style": "guide-title",
      "from": {
        "data": "tile"
      },
      "encode": {
        "enter": {
          "font": {
            "value": "\"Elastic UI Numeric\", Inter, system-ui, sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 500
          }
        },
        "update": {
          "x": {
            "signal": "pad"
          },
          "y": {
            "signal": "pad + 2.5"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "value": "Audit data held"
          },
          "limit": {
            "signal": "width - 2 * pad"
          },
          "fill": {
            "signal": "length(data('theme')) && luminance(data('theme')[0].fill) > 0.18 ? '#E3E8F2' : '#111C2C'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "value",
      "style": "guide-title",
      "from": {
        "data": "tile"
      },
      "encode": {
        "enter": {
          "font": {
            "value": "\"Elastic UI Numeric\", Inter, system-ui, sans-serif"
          },
          "fontSize": {
            "value": 36
          },
          "fontWeight": {
            "value": 500
          }
        },
        "update": {
          "x": {
            "signal": "width - pad"
          },
          "y": {
            "signal": "height - pad - 36.6"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "field": "value"
          },
          "fill": {
            "signal": "length(data('theme')) && luminance(data('theme')[0].fill) > 0.18 ? '#E3E8F2' : '#111C2C'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "detail",
      "style": "guide-label",
      "from": {
        "data": "tile"
      },
      "encode": {
        "enter": {
          "font": {
            "value": "\"Elastic UI Numeric\", Inter, system-ui, sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 500
          }
        },
        "update": {
          "x": {
            "signal": "width - pad"
          },
          "y": {
            "signal": "height - pad - 63.3"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "field": "detail"
          },
          "limit": {
            "signal": "width - 2 * pad"
          },
          "fill": {
            "signal": "length(data('theme')) && luminance(data('theme')[0].fill) > 0.18 ? '#CAD3E2' : '#1D2A3E'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "note",
      "style": "guide-label",
      "from": {
        "data": "tile"
      },
      "encode": {
        "enter": {
          "font": {
            "value": "\"Elastic UI Numeric\", Inter, system-ui, sans-serif"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": 500
          }
        },
        "update": {
          "x": {
            "signal": "pad"
          },
          "y": {
            "signal": "height - pad - 12"
          },
          "baseline": {
            "value": "alphabetic"
          },
          "text": {
            "field": "note"
          },
          "limit": {
            "signal": "width - 2 * pad - 140"
          },
          "fill": {
            "signal": "length(data('theme')) && luminance(data('theme')[0].fill) > 0.18 ? '#CAD3E2' : '#1D2A3E'"
          }
        }
      }
    }
  ]
}
